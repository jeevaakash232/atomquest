# ─── Copy this to .env and fill in your values ────────────────────────────────

# ─── AWS Bedrock (AI) ─────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=mistral.mistral-7b-instruct-v0:2
BEDROCK_REGION=us-east-1

# ─── AWS Credentials ──────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_S3_BUCKET_NAME=atomquest-files
AWS_S3_REGION=us-east-1

# ─── AWS DynamoDB ─────────────────────────────────────────────────────────────
DYNAMODB_TABLE_GOALS=atomquest-goals
DYNAMODB_TABLE_USERS=atomquest-users
DYNAMODB_TABLE_ACTIVITY=atomquest-activity
DYNAMODB_TABLE_NOTIFICATIONS=atomquest-notifications

# ─── AWS Lambda ───────────────────────────────────────────────────────────────
LAMBDA_FUNCTION_ANALYTICS=atomquest-analytics
LAMBDA_FUNCTION_AI_BATCH=atomquest-ai-batch
LAMBDA_FUNCTION_NOTIFICATIONS=atomquest-notifications-processor

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET=change-this-to-a-random-64-char-string-in-production

# ─── App ──────────────────────────────────────────────────────────────────────
# Set this to your Vercel deployment URL after deploying
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NODE_ENV=production
